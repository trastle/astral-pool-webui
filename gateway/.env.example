CHLORINATOR_DEVICE_NAME=POOL01
CHLORINATOR_ACCESS_CODE=changeme
POLL_INTERVAL_SECONDS=60
HTTP_PORT=8080

# MQTT is optional - leave MQTT_HOST unset to run without it (dashboard and
# /metrics keep working either way). Set these once the Mosquitto broker
# add-on (or equivalent) is running in Home Assistant.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# MQTT_BASE_TOPIC left unset on purpose - defaults to chlorinator/<name>
# (matching hwmaier/chlorinator-gateway's topic scheme). Only set this to
# override that.
