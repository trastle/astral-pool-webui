# Copy this file to .secrets.yaml (gitignored - never commit the real
# file) and fill in your chlorinator's Bluetooth access code - the same
# code the "Chlorinator Go" phone app uses to pair.
#
# You can use a GATEWAY_CHLORINATOR__ACCESS_CODE environment variable
# instead if you prefer not to keep it in a file at all (e.g. injected by
# a secrets manager or systemd's EnvironmentFile=) - either way works.
chlorinator:
  access_code: changeme

# Despite the filename, this file is really "any override specific to
# this one install" - not just secrets. provision.sh copies it into the
# service account's home directory and preserves it across redeploys,
# unlike a hand-edited systemd unit (which provision.sh regenerates from
# scratch every run). Uncomment/add anything from settings.yaml here that
# should differ on this particular install, e.g.:
# mqtt:
#   host: 192.168.1.50
#   username: pool
