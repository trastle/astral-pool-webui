# Copy this file to .secrets.yaml (gitignored - never commit the real
# file) and fill in your chlorinator's Bluetooth access code - the same
# code the "Chlorinator Go" phone app uses to pair.
#
# You can use a GATEWAY_CHLORINATOR__ACCESS_CODE environment variable
# instead if you prefer not to keep it in a file at all (e.g. injected by
# a secrets manager or systemd's EnvironmentFile=) - either way works.
chlorinator:
  access_code: changeme
